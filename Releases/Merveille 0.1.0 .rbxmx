					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Result</string>
					<ProtectedString name="Source">--!strict
		
		--&gt;	["result"]
		--&gt;	Rust-style result carrier.
		--&gt;	Use this when an operation can fail and you want the value and failure state
		--&gt;	to stay explicit without comparing magic nil shapes.
		
		local Result = {}
		Result.__index = Result
		
		function Result.ok(value: any)
			return setmetatable({
				_tag = "Ok",
				_value = value,
				_error = nil,
			}, Result)
		end
		
		function Result.err(reason: any)
			return setmetatable({
				_tag = "Err",
				_value = nil,
				_error = reason,
			}, Result)
		end
		
		function Result:isOk(): boolean
			return self._tag == "Ok"
		end
		
		function Result:isErr(): boolean
			return self._tag == "Err"
		end
		
		function Result:unwrap()
			assert(self._tag == "Ok", `[Merveille/Result] called unwrap() on Err: {tostring(self._error)}`)
			return self._value
		end
		
		function Result:unwrapErr()
			assert(self._tag == "Err", "[Merveille/Result] called unwrapErr() on Ok")
			return self._error
		end
		
		function Result:unwrapOr(fallback: any)
			if self._tag == "Ok" then
				return self._value
			end
			return fallback
		end
		
		function Result:map(fn: (any) -&gt; any)
			if self._tag == "Ok" then
				return Result.ok(fn(self._value))
			end
			return self
		end
		
		function Result:mapErr(fn: (any) -&gt; any)
			if self._tag == "Err" then
				return Result.err(fn(self._error))
			end
			return self
		end
		
		function Result:match(onOk: (any) -&gt; any, onErr: (any) -&gt; any)
			if self._tag == "Ok" then
				return onOk(self._value)
			end
			return onErr(self._error)
		end
		
		return table.freeze({
			ok = Result.ok,
			err = Result.err,
		})
		</ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6b0d10022ae4ca23">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">SHA256</string>
					<ProtectedString name="Source">--!strict
		
		--&gt;	["sha256"]
		--&gt;	Binary sha256 digest helper.
		--&gt;	This exists so the vault layer can authenticate sealed records instead of only
		--&gt;	encrypting them. It is also exposed for callers that want a stronger digest
		--&gt;	than the small hash32 helper.
		
		local SHA256 = {}
		
		local WORD = 4294967296
		
		local K = {
			0x428A2F98,
			0x71374491,
			0xB5C0FBCF,
			0xE9B5DBA5,
			0x3956C25B,
			0x59F111F1,
			0x923F82A4,
			0xAB1C5ED5,
			0xD807AA98,
			0x12835B01,
			0x243185BE,
			0x550C7DC3,
			0x72BE5D74,
			0x80DEB1FE,
			0x9BDC06A7,
			0xC19BF174,
			0xE49B69C1,
			0xEFBE4786,
			0x0FC19DC6,
			0x240CA1CC,
			0x2DE92C6F,
			0x4A7484AA,
			0x5CB0A9DC,
			0x76F988DA,
			0x983E5152,
			0xA831C66D,
			0xB00327C8,
			0xBF597FC7,
			0xC6E00BF3,
			0xD5A79147,
			0x06CA6351,
			0x14292967,
			0x27B70A85,
			0x2E1B2138,
			0x4D2C6DFC,
			0x53380D13,
			0x650A7354,
			0x766A0ABB,
			0x81C2C92E,
			0x92722C85,
			0xA2BFE8A1,
			0xA81A664B,
			0xC24B8B70,
			0xC76C51A3,
			0xD192E819,
			0xD6990624,
			0xF40E3585,
			0x106AA070,
			0x19A4C116,
			0x1E376C08,
			0x2748774C,
			0x34B0BCB5,
			0x391C0CB3,
			0x4ED8AA4A,
			0x5B9CCA4F,
			0x682E6FF3,
			0x748F82EE,
			0x78A5636F,
			0x84C87814,
			0x8CC70208,
			0x90BEFFFA,
			0xA4506CEB,
			0xBEF9A3F7,
			0xC67178F2,
		}
		
		local function add(...: number): number
			local total = 0
			for index = 1, select("#", ...) do
				total = (total + select(index, ...)) % WORD
			end
			return total
		end
		
		local function bytesFrom(source: any, offset: number?, length: number?): { number }
			local out = {}
			if type(source) == "string" then
				local start = if offset == nil then 0 else offset
				local count = if length == nil then #source - start else length
				for index = 0, count - 1 do
					out[#out + 1] = string.byte(source, start + index + 1)
				end
				return out
			end
			assert(typeof(source) == "buffer", "[Merveille/SHA256] expected string or buffer")
			local start = if offset == nil then 0 else offset
			local count = if length == nil then buffer.len(source) - start else length
			for index = 0, count - 1 do
				out[#out + 1] = buffer.readu8(source, start + index)
			end
			return out
		end
		
		local function writeWordBE(target: buffer, offset: number, value: number)
			buffer.writeu8(target, offset, bit32.band(bit32.rshift(value, 24), 0xFF))
			buffer.writeu8(target, offset + 1, bit32.band(bit32.rshift(value, 16), 0xFF))
			buffer.writeu8(target, offset + 2, bit32.band(bit32.rshift(value, 8), 0xFF))
			buffer.writeu8(target, offset + 3, bit32.band(value, 0xFF))
		end
		
		local function digestBytes(bytes: { number }): buffer
			local bitLength = #bytes * 8
			bytes[#bytes + 1] = 0x80
			while (#bytes % 64) ~= 56 do
				bytes[#bytes + 1] = 0
			end
		
			local high = math.floor(bitLength / WORD)
			local low = bitLength % WORD
			bytes[#bytes + 1] = bit32.band(bit32.rshift(high, 24), 0xFF)
			bytes[#bytes + 1] = bit32.band(bit32.rshift(high, 16), 0xFF)
			bytes[#bytes + 1] = bit32.band(bit32.rshift(high, 8), 0xFF)
			bytes[#bytes + 1] = bit32.band(high, 0xFF)
			bytes[#bytes + 1] = bit32.band(bit32.rshift(low, 24), 0xFF)
			bytes[#bytes + 1] = bit32.band(bit32.rshift(low, 16), 0xFF)
			bytes[#bytes + 1] = bit32.band(bit32.rshift(low, 8), 0xFF)
			bytes[#bytes + 1] = bit32.band(low, 0xFF)
		
			local h0 = 0x6A09E667
			local h1 = 0xBB67AE85
			local h2 = 0x3C6EF372
			local h3 = 0xA54FF53A
			local h4 = 0x510E527F
			local h5 = 0x9B05688C
			local h6 = 0x1F83D9AB
			local h7 = 0x5BE0CD19
		
			local w = table.create(64, 0)
		
			for chunk = 1, #bytes, 64 do
				for index = 0, 15 do
					local at = chunk + index * 4
					w[index + 1] = bit32.bor(
						bit32.lshift(bytes[at], 24),
						bit32.lshift(bytes[at + 1], 16),
						bit32.lshift(bytes[at + 2], 8),
